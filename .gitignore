.venv/
__pycache__/
*.pyc

demo/output/*
!demo/output/.gitkeep

# The installed copy of the Skill, inside the demo project. Never
# tracked: skill-source/ holds the versions, scripts/install-skill.sh
# copies one in. Untracked means reset/install never shows up in
# `git status`, so nothing invites the agent to "restore" it.
demo/.claude/skills/
